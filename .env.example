# Variables d'environnement publiques — copier en .env.local pour le dev.
# En prod : Netlify dashboard → Site settings → Environment variables.

# URL canonique du site (utilisé par metadata, OG, sitemap, robots).
# - En local : http://localhost:3000
# - Première mise en ligne Netlify : https://[your-site].netlify.app
# - Domaine custom plus tard : https://guillaumegay.fr
NEXT_PUBLIC_SITE_URL=https://guillaumegay.fr

# Domaine Plausible (sans https://, ex: guillaumegay.fr).
# Laisser vide en local pour désactiver le tracking dev.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Hash de commit injecté au build (mappé sur $COMMIT_REF par netlify.toml).
# En local : laisser "dev". En prod Netlify : mapping fait automatiquement.
NEXT_PUBLIC_BUILD_HASH=dev
